APP_ENV=development
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://dom:change-this-local-password@localhost:5434/dom
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:8000
RECEIPT_STORAGE=./data/receipts
# manual = editable draft; openai / gemini = real AI extraction; fixture = bundled image only
RECEIPT_PROVIDER=manual
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CLASSIFICATION_AUTO_THRESHOLD=0.90
CLASSIFICATION_REVIEW_THRESHOLD=0.60
# Seed only: choose a password (at least 10 characters), never enabled in production
DEMO_PASSWORD=

# Only for compose.production.yaml, DNS must point to your server
DOMAIN=

# AI budget proposals: auto reuses receipt provider; history disables paid AI.
BUDGET_AI_PROVIDER=auto
